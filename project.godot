config_version=5

[application]

config/name="Runtime Procedural World Generation (4.5)"
config/description="Procedural world generation demo project, including random items or obstacles spawns and with physics enabled. Comes with a third-person infinite runner showcase project."
run/main_scene="res://_scenes/bootstrapper.tscn"
config/features=PackedStringArray("4.5", "C#", "Mobile")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.03, 0.04, 0.055, 1)
boot_splash/minimum_display_time=0

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
input_devices/pointing/emulate_touch_from_mouse=true

[dotnet]

project/assembly_name="Procedural Infinite Runner"

[filesystem]

import/fbx/enabled=false

