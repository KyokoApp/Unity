[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

occlusion_culling/bvh_build_quality=1
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
scaling_3d/mode=1
scaling_3d/scale=0.9
scaling_3d/fsr_sharpness=0.2
mesh_lod/lod_change/threshold_pixels=3.0
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.20041, 0.29506, 0.484753, 1)
