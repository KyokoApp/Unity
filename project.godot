; ============================================================
; AURELIA — project Godot 4 (hasil migrasi penuh dari Unity 6)
;
; Game: RPG open-world anime bergaya Genshin (dunia 3 km x 3 km,
; 7 region, terrain prosedural streaming, karakter anime dengan
; animasi prosedural 25 sendi, HUD ala Genshin, siklus siang/malam).
;
; Renderer: Mobile (Forward+) — target utama Android, sama seperti
; keputusan URP di project Unity sebelumnya (lihat DESAIN.md BAB 5).
; ============================================================

config_version=5

[application]

config/name="Aurelia"
config/description="RPG open-world anime — dunia 3x3 km dengan 7 region, dimigrasi penuh dari Unity ke Godot 4."
run/main_scene="res://scenes/world.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.5", "Mobile")

[bootstrap]

; BootLog & registrasi global shader dikerjakan dari kode (world_boot.gd),
; supaya urutan inisialisasi identik dengan jalur test headless.

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; Landscape paksa (sama seperti Screen.orientation=LandscapeLeft di Unity).
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

textures/vram_compression/import_etc2_astc=true

; Renderer Mobile: satu langkah maju di atas "compatibility" untuk
; mendapat glow (bloom) + PSSM shadow tanpa biaya Full Forward+.
; Setara pilihan URP di Unity untuk target HP.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/16_bits=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0

[gui]

; Font bawaan dipakai sampai punya font OFL kustom (lihat ui/ui_kit.gd).
theme/default_font_antialiasing=1

[internationalization]

locale/translations=PackedStringArray()

[shader_globals]

; Uniform global yang dibaca semua shader Aurelia (fog/matahari/ambient).
; DayNightCycle.apply() memutakhirkannya per frame; QualityApplier
; menimpa aurelia_fog_near/far sesuai tingkat jarak pandang.
aurelia_fog_color={"type":"color","value":Color(0.62, 0.7, 0.8, 1)}
aurelia_fog_near={"type":"float","value":260}
aurelia_fog_far={"type":"float","value":950}
aurelia_sun_color={"type":"color","value":Color(1, 0.96, 0.88, 1)}
aurelia_sun_direction={"type":"vec3","value":Vector3(0.35, 0.55, 0.30)}
aurelia_ambient_color={"type":"color","value":Color(0.5, 0.56, 0.64, 1)}
