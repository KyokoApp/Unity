# CATATAN: node HTTPRequest ini tidak lagi dipakai oleh Bootstrapper.cs
# (downloader baru berbasis HttpClient dengan resume + stall detection).
# timeout = 0 artinya TANPA batas total — mencegah kambuhnya bug "stuck 80MB"
# (timeout Godot membatalkan total durasi request, bukan idle time).
[node name="ManifestRequest" type="HTTPRequest" parent="."]
use_threads = true
timeout = 0.0

[node name="DownloadRequest" type="HTTPRequest" parent="."]
use_threads = true
timeout = 0.0
