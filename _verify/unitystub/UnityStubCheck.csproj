<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>StubCheck</AssemblyName>
    <!-- Editor skrip Unity Sungguh dikompilasi dengan UNITY_EDITOR terdefinisi;
         tanpanya blok #if UNITY_EDITOR (mis. AureliaCILogTap) tidak pernah
         diperiksa harness, dan error di dalamnya lolos ke CI. -->
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_6000_0_OR_NEWER</DefineConstants>
    <NoWarn>CS0169;CS0414;CS0649;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <!-- Harness ini memeriksa kompilasi skrip Unity DI LUAR Unity.
         Lihat README.md di folder ini untuk apa yang ia buktikan dan tidak. -->
    <Compile Include="Attrs.cs" />
    <Compile Include="EditorStubs.cs" />
    <!-- Tiruan API UniVRM v0.131.2 untuk VrmPrefabBuilder.cs. Tanda tangan
         disalin dari sumber aslinya; lihat header UniVrmStubs.cs. -->
    <Compile Include="UniVrmStubs.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Editor/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Core/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Runtime/*.cs" />
  </ItemGroup>
</Project>
