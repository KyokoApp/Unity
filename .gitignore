# ============================================================
# .gitignore — proyek Godot 4
# ============================================================

# ---- Godot 4 ----
.godot/
android/
addons/
*.translation

# Hasil ekspor
build/
exports/
*.apk
*.aab
*.ipa
*.app
*.dmg
*.zip

# Data pengguna (perangkat lokal)
user/

# ---- model karakter (lihat models/LISENSI.md) ----
# AureliaChar.vrm-nya licenseName=Redistribution_Prohibited — file tidak
# pernah di-commit, konversi lokal menjadi GLB pun tidak.
models/*.vrm
models/*.glb
models/*.glb.import
models/*.tscn

# ---- sisa konsumsi lain ----
*.tmp
*.swp
.DS_Store
__pycache__/
