[gd_resource type="BoneMap" load_steps=2 format=3]

; VRM (J_Bip_*) anime character -> SkeletonProfileHumanoid
; Maps source bone names onto Godot's SkeletonProfileHumanoid so that animations can be
; retargeted between the two rigs. Godot uses this to correct for the different rest
; orientations of each skeleton, which a raw quaternion copy cannot do.

[sub_resource type="SkeletonProfileHumanoid" id="SkeletonProfileHumanoid_1"]

[resource]
profile = SubResource("SkeletonProfileHumanoid_1")
bone_map = {
&"J_Bip_C_Chest": &"Chest",
&"J_Bip_C_Head": &"Head",
&"J_Bip_C_Hips": &"Hips",
